{
  "name": "altivar-11-simulator",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/unit/*.test.mjs",
    "build": "node build.mjs",
    "test:browser": "playwright test",
    "verify": "pnpm verify:light && pnpm test:browser",
    "verify:light": "pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@playwright/test": "1.59.1",
    "@types/node": "24.19.2",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "parse5": "8.0.1",
    "typescript": "7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}

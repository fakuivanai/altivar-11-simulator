{
  "name": "drive-simulator",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node build.mjs",
    "test": "node --import ./tests/register.mjs --test tests/unit/*.test.mjs && node test-controller.mjs",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
